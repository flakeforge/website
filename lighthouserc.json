{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec next start --port 3100",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3100/en",
        "http://localhost:3100/en/work",
        "http://localhost:3100/en/work/fin",
        "http://localhost:3100/en/blog",
        "http://localhost:3100/en/blog/three-languages-one-blog",
        "http://localhost:3100/en/contact"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
